{
  "manifest_version": 3,
  "name": "MathScope",
  "version": "0.2.0",
  "description": "Plot equations on Wikipedia: curves, surfaces, vector fields and 3D shapes, with sliders.",
  "content_scripts": [
    {
      "matches": ["https://*.wikipedia.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["https://*.wikipedia.org/*"]
    }
  ]
}
